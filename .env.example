# Copy to .env and edit. All values are optional.

# Port the Node server listens on (nginx proxies to this).
PORT=8712

# Bind address. Keep 127.0.0.1 when nginx sits in front of the app.
HOST=127.0.0.1

# Lock screen. Set ONE of these; leave both empty for an open instance
# (only sensible on a LAN you trust).
#
# WEBTOOLS_PIN takes priority and, when it is 4-12 digits, the login screen
# becomes a keypad. Five wrong entries lock that visitor out for a minute,
# and each further run of five multiplies the wait up to an hour.
#
# A 4-digit PIN is 10,000 combinations. The lockout is what makes that safe
# enough to expose; a 6-digit PIN is a hundred times better for free.
WEBTOOLS_PIN=

# Anything non-numeric here gets a normal password field instead.
WEBTOOLS_PASSWORD=

# Where the SQLite db, uploads and thumbnails live.
DATA_DIR=./data

# Max upload size for the document organizer, in megabytes.
MAX_UPLOAD_MB=40

# Set to 1 if you terminate TLS in front of the app (nginx); makes the
# session cookie Secure-only.
TRUST_PROXY=1
