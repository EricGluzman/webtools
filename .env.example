# Copy to .env and edit. All values are optional.

# Port the Node server listens on (nginx proxies to this).
PORT=8712

# Bind address. Keep 127.0.0.1 when nginx sits in front of the app.
HOST=127.0.0.1

# Password gate. Leave empty for an open instance (only do that on a LAN).
# Anything non-empty turns on the login screen for the whole site.
WEBTOOLS_PASSWORD=

# Where the SQLite db, uploads and thumbnails live.
DATA_DIR=./data

# Max upload size for the document organizer, in megabytes.
MAX_UPLOAD_MB=40

# Set to 1 if you terminate TLS in front of the app (nginx); makes the
# session cookie Secure-only.
TRUST_PROXY=1
